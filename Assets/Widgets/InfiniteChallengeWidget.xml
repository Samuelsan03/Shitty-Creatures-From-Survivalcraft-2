<CanvasWidget xmlns="runtime-namespace:Game" Size="614, 440">
  <BevelledRectangleWidget BevelSize="3" CenterColor="20, 20, 28, 255" />

  <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">

    <CanvasWidget Size="0, 8"/>

    <LabelWidget Name="TitleLabel" Text="[InfiniteChallengeWidget:0]" Color="255, 160, 80" FontScale="1.3" HorizontalAlignment="Center"/>
    <CanvasWidget Size="0, 4" />
    <LabelWidget Name="SubtitleLabel" Text="[InfiniteChallengeWidget:1]" Color="160, 160, 160, 255" HorizontalAlignment="Center" />

    <CanvasWidget Size="0, 16"/>

    <!-- Área de texto con scroll (altura fija) -->
    <CanvasWidget Size="560, 250">
      <ScrollPanelWidget Direction="Vertical">
        <StackPanelWidget Direction="Vertical" Margin="0, 0, 0, 10">
          <LabelWidget Name="Line1Label" Text="[InfiniteChallengeWidget:2]" Color="220, 220, 220" HorizontalAlignment="Center" WordWrap="true"/>
          <CanvasWidget Size="0, 12"/>
          <LabelWidget Name="Line2Label" Text="[InfiniteChallengeWidget:3]" Color="220, 220, 220" HorizontalAlignment="Center" WordWrap="true"/>
          <CanvasWidget Size="0, 12"/>
          <LabelWidget Name="Line3Label" Text="[InfiniteChallengeWidget:4]" Color="220, 220, 220" HorizontalAlignment="Center" WordWrap="true"/>
          <CanvasWidget Size="0, 12"/>
          <LabelWidget Name="Line4Label" Text="[InfiniteChallengeWidget:5]" Color="220, 220, 220" HorizontalAlignment="Center" WordWrap="true"/>
          <CanvasWidget Size="0, 16"/>
          <LabelWidget Name="QuestionLabel" Text="[InfiniteChallengeWidget:6]" Color="255, 200, 100" HorizontalAlignment="Center" FontScale="1.1" WordWrap="true"/>

          <!-- ✅ Botón Skip DENTRO del texto, al final -->
          <CanvasWidget Size="0, 20"/>
          <BevelledButtonWidget Name="SkipButton" Size="200, 46" HorizontalAlignment="Center" Style="{Styles/ButtonStyle_160x60}">
            <LabelWidget Name="SkipLabel" Text="[InfiniteChallengeWidget:10]" Color="255, 220, 120" HorizontalAlignment="Center" VerticalAlignment="Center" FontScale="1.0"/>
          </BevelledButtonWidget>
        </StackPanelWidget>
      </ScrollPanelWidget>
    </CanvasWidget>

    <CanvasWidget Size="0, 16"/>

    <!-- Los otros botones se conservan como antes -->
    <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center">
      <BevelledButtonWidget Name="AcceptButton" Size="140, 48" Margin="16,0" Style="{Styles/ButtonStyle_160x60}">
        <LabelWidget Name="AcceptLabel" Text="[InfiniteChallengeWidget:7]" Color="160, 255, 160" HorizontalAlignment="Center" VerticalAlignment="Center" FontScale="1.1"/>
      </BevelledButtonWidget>

      <BevelledButtonWidget Name="RejectButton" Size="140, 48" Margin="16,0" Style="{Styles/ButtonStyle_160x60}">
        <LabelWidget Name="RejectLabel" Text="[InfiniteChallengeWidget:8]" Color="255, 160, 160" HorizontalAlignment="Center" VerticalAlignment="Center" FontScale="1.1"/>
      </BevelledButtonWidget>
    </StackPanelWidget>

    <CanvasWidget Size="0, 12"/>

  </StackPanelWidget>
</CanvasWidget>
